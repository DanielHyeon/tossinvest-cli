$ systemctl --user cat tossos-a140-kr.service tossos-a140-kr.timer
# ~/.config/systemd/user/tossos-a140-kr.service
[Unit]
Description=TossOS a140 KR breakout shadow measurement
After=network-online.target

[Service]
Type=simple
# 사용자 지시(2026-10-19): 그림자 측정을 매일 사람이 띄우지 않도록 타이머로 기동.
# 읽기 전용 GET 측정이며 주문 · 정정 · 취소를 내지 않음.
