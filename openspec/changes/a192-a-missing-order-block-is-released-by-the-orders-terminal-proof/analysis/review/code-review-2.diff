+
+func a192Order(id string) boundOrder {
+	return boundOrder{
+		identity: OrderIdentity{AccountRef: a192Account, Market: "kr", TradingDay: "2026-03-30",
+			Symbol: a192Symbol, Side: "SELL", OrderID: id},
+		original: id,
+	}
