+type fieldCheck struct {
+	name   string
+	failed bool
+}
+
+func failedFields(checks ...fieldCheck) []string {
+	var fields []string
+	for _, check := range checks {
+		if check.failed {
+			fields = append(fields, check.name)
+		}
+	}
+	return fields
+}
