diff --git a/internal/filldetect/closed_lookup.go b/internal/filldetect/closed_lookup.go
new file mode 100644
index 000000000..5c6fa524b
--- /dev/null
+++ b/internal/filldetect/closed_lookup.go
@@ -0,0 +1,329 @@
+package filldetect
+
+// closed_lookup.go 는 a191 — 미체결(OPEN) 목록을 떠났는데 단건 조회가 「살아 있음」을 돌려주는 추적 주문의 종결을
+// 종결(CLOSED) 목록으로 확인함.
+//
+// # 왜 필요한가
+//
+// 토스 단건 조회는 KR 주문을 앱에서 취소해도 옛 주문번호를 계속 PENDING(취소 시각 없음)으로 돌려줌
+// (verify-execution-capability measurements M32). 그러면 collect 는 그 주문을 매 주기 「열림·미체결」로 읽고 종결을
+// 쓰지 않아, 추적 집합과 대사의 열린 주문에 영원히 남음(missing-order → 계좌 영구 차단).
+//
+// # 받아들이는 경우는 하나뿐임 (design D3)
+//
+// 같은 주문번호(바이트 동일)·같은 정규 범위 행이 정확히 하나이고, 그 행에 체결 수량이 실제로 있고(M6), 그 행의 파생이
+// 깨끗한 종결이며, 주문·체결 수량이 단건과 같을 때만. 그때도 바꾸는 것은 **상태 필드뿐**임 — 수량·평균가·금액·체결 시각은
+// 단건 것을 유지함(종결 목록 혼자서 체결을 만들거나 지우지 않음).
+//
+// # 그 밖은 오늘과 같음 (design D4)
+//
+// 못 찾음·읽기 실패·모호 등 어느 경우든 단건 스냅숏을 그대로 쓰고, 주기를 실패시키지 않으며, 새 refusal·래치를 만들지
+// 않음. 사유 코드만 남기고 30s 이상 이어지면 한 번 알림(D6).
+//
+// # 조회량과 시간 (design D5, Manager M8)
+//
+// 주기당 조회 최대 1건(안 물은 것 먼저, 그다음 lastLookup 이 가장 오래된 것), 같은 주문은 30s 간격, 조회 전체에 2s
+// 취소 시한. 간격·보고 판정은 주입 Clock 으로 함 — context 시한은 매달린 전송을 끊는 용도로만 씀.
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/JungHoonGhae/tossinvest-cli/internal/brokerstate"
+	"github.com/JungHoonGhae/tossinvest-cli/internal/execgw"
+	"github.com/JungHoonGhae/tossinvest-cli/internal/obs"
+)
+
+// Alerter 는 운영자 알림 통로임. 운영 배선은 *obs.Notifier.
+type Alerter interface {
+	Notify(ctx context.Context, e obs.Event) error
+}
+
+// EventFillOrderUnresolved 는 목록을 떠난 추적 주문이 종결 목록으로 확인되지 않은 채 이어짐을 알림.
+// a129 선례대로 internal/obs 를 고치지 않고 지역 리터럴로 둠 — 등급표에 없으므로 normal(전달 보장 없음).
+const EventFillOrderUnresolved obs.EventType = "fill.order_unresolved"
+
+// UnresolvedReason 은 종결 목록이 그 주기에 종결을 확인하지 못한 사유임. 안정 문자열(경보에 실림).
+type UnresolvedReason string
+
+const (
+	UnresolvedClosedListNotFound          UnresolvedReason = "closed_list_not_found"
+	UnresolvedClosedListReadFailed        UnresolvedReason = "closed_list_read_failed"
+	UnresolvedClosedListTruncated         UnresolvedReason = "closed_list_truncated"
+	UnresolvedClosedListRowUnreadable     UnresolvedReason = "closed_list_row_unreadable"
+	UnresolvedClosedListAmbiguous         UnresolvedReason = "closed_list_ambiguous"
+	UnresolvedClosedListScopeMismatch     UnresolvedReason = "closed_list_scope_mismatch"
+	UnresolvedClosedListExecutionMissing  UnresolvedReason = "closed_list_execution_missing"
+	UnresolvedClosedListNotCleanTerminal  UnresolvedReason = "closed_list_not_clean_terminal"
+	UnresolvedClosedListQuantityDisagrees UnresolvedReason = "closed_list_quantity_disagrees"
+	UnresolvedClosedLookupWindowInvalid   UnresolvedReason = "closed_lookup_window_invalid"
+	UnresolvedClosedLookupDeferred        UnresolvedReason = "closed_lookup_deferred"
+)
+
+// UnresolvedOrder 는 그 주기에 종결 목록으로 확인되지 않은 후보 하나임(주기 결과용 — 경보에는 OrderID 를 싣지 않음).
+type UnresolvedOrder struct {
+	OrderID  string
+	IntentID string
+	Market   string
+	Reason   UnresolvedReason
+}
+
+const (
+	statusClosed          = "CLOSED"
+	closedLookupLimit     = 100
+	closedLookupMaxPages  = 3
+	closedLookupDeadline  = 2 * time.Second
+	closedLookupInterval  = 30 * time.Second
+	unresolvedReportAfter = 30 * time.Second
+	closedTradingDay      = "2006-01-02"
+)
+
+// leftOpenTrack 은 후보 키 하나의 간격·보고 상태임. poll 뮤텍스 아래에서만 읽고 씀.
+type leftOpenTrack struct {
+	firstSeen  time.Time
+	lastLookup time.Time
+	lastReason UnresolvedReason
+	reported   bool
+}
+
+// leftOpenCandidate 는 한 주기의 후보임. cycle 포인터가 그 주기의 신원이라, 중간에 실패한 주기의 후보는 다음 주기에 버려짐.
+type leftOpenCandidate struct {
+	cycle *Cycle
+	key   canonicalOrderKey
+	order TrackedOrder
+	index int
+}
+
+// noteLeftOpen 은 collect 가 OPEN 에서 못 본 추적 주문의 단건 스냅숏을 붙이기 직전에 부름.
+// 후보는 단건 파생이 비종결이면서 fail-closed 가 아닐 때뿐임(M2 = 제외 — UNKNOWN 은 기존 refusal 경로 그대로).
+func (d *Detector) noteLeftOpen(cycle *Cycle, key canonicalOrderKey, order TrackedOrder, index int, snap Snapshot) {
+	if snap.Derived.Terminal || snap.Derived.FailClosed {
+		return
+	}
+	// 앞 주기가 settle 전에 오류로 끝났으면 그 후보가 남아 있음 — 이번 주기 것만 남겨 쌓이지 않게 함(코드 리뷰 1 #1).
+	if len(d.leftOpenCycle) > 0 && d.leftOpenCycle[0].cycle != cycle {
+		d.leftOpenCycle = d.leftOpenCycle[:0]
+	}
+	d.leftOpenCycle = append(d.leftOpenCycle, leftOpenCandidate{cycle: cycle, key: key, order: order, index: index})
+}
+
+// settleLeftOpen 은 collect 의 끝에서 부름 — 이번 주기 후보 가운데 하나만 종결 목록에 묻고, 받아들이면 그 스냅숏의 상태
+// 필드를 바꾸며, 간격 상태를 정리하고, 오래 이어진 미해결을 한 번 알림.
+func (d *Detector) settleLeftOpen(ctx context.Context, cycle *Cycle, snaps []Snapshot) []Snapshot {
+	candidates := make([]leftOpenCandidate, 0, len(d.leftOpenCycle))
+	for _, c := range d.leftOpenCycle {
+		if c.cycle == cycle {
+			candidates = append(candidates, c)
+		}
+	}
+	d.leftOpenCycle = nil
+
+	now := d.clk().Now()
+	if d.leftOpen == nil {
+		d.leftOpen = map[canonicalOrderKey]*leftOpenTrack{}
+	}
+	current := make(map[canonicalOrderKey]bool, len(candidates))
+	for _, c := range candidates {
+		current[c.key] = true
+		if _, known := d.leftOpen[c.key]; !known {
+			d.leftOpen[c.key] = &leftOpenTrack{firstSeen: now}
+		}
+	}
+	// 이번 주기 후보가 아닌 키는 해결된 것임(OPEN 재등장·종결·추적 종료) — 상태를 지워 다시 생기면 처음부터 셈.
+	for key := range d.leftOpen {
+		if !current[key] {
+			delete(d.leftOpen, key)
+		}
+	}
+
+	chosen := pickClosedLookup(candidates, d.leftOpen, now)
+	for i, c := range candidates {
+		track := d.leftOpen[c.key]
+		reason := UnresolvedClosedLookupDeferred
+		if i == chosen {
+			// 결과와 상관없이 물은 시각을 남김 — 실패해도 같은 주기 재시도는 없고 간격 뒤에 다시 물음.
+			track.lastLookup = now
+			cycle.ClosedReads++
+			accepted, why := d.lookupClosed(ctx, c, snaps[c.index])
+			if why == "" {
+				// 상태는 지우지 않음 — 이 스냅숏이 원장에 적용되기 전에 주기가 실패하면 다음 주기에도 후보로 남는데,
+				// 그때 30s 간격을 지켜야 함(코드 리뷰 1 #2). 다음 주기에 후보가 아니면 위 정리가 지움.
+				snaps[c.index] = accepted
+				continue
+			}
+			reason = why
+			track.lastReason = why
+		}
+		cycle.Unresolved = append(cycle.Unresolved, UnresolvedOrder{
+			OrderID: c.order.OrderID, IntentID: c.order.IntentID, Market: c.key.Market, Reason: reason,
+		})
+		if !track.reported && now.Sub(track.firstSeen) >= unresolvedReportAfter {
+			track.reported = true
+			reported := track.lastReason
+			if reported == "" {
+				reported = reason
+			}
+			d.reportUnresolved(ctx, c, reported, now.Sub(track.firstSeen))
+		}
+	}
+	return snaps
+}
+
+// pickClosedLookup 은 이번 주기에 물을 후보 하나의 위치를 고름(없으면 -1).
+// 간격이 지난 것만 대상이고, 한 번도 안 물은 것이 먼저, 그다음 lastLookup 이 가장 오래된 것, 같으면 추적 순서.
+func pickClosedLookup(candidates []leftOpenCandidate, tracks map[canonicalOrderKey]*leftOpenTrack, now time.Time) int {
+	chosen := -1
+	var chosenAt time.Time
+	for i, c := range candidates {
+		last := tracks[c.key].lastLookup
+		if !last.IsZero() && now.Sub(last) < closedLookupInterval {
+			continue
+		}
+		if chosen == -1 || (!chosenAt.IsZero() && (last.IsZero() || last.Before(chosenAt))) {
+			chosen, chosenAt = i, last
+		}
+	}
+	return chosen
+}
+
+// lookupClosed 는 후보 하나를 종결 목록에서 찾아 수용 조건(design D3)을 판정함. 받아들이면 상태 필드만 바꾼 단건
+// 스냅숏과 빈 사유를, 아니면 사유를 돌려줌.
+func (d *Detector) lookupClosed(ctx context.Context, c leftOpenCandidate, single Snapshot) (Snapshot, UnresolvedReason) {
+	day, err := time.Parse(closedTradingDay, c.key.TradingDay)
+	if err != nil {
+		return Snapshot{}, UnresolvedClosedLookupWindowInvalid
+	}
+	// from/to 는 KST 주문 생성일이고 거래일은 시장 현지 날짜라, 앞뒤 하루로 둘 다 덮음.
+	query := execgw.OrderQuery{
+		Status: statusClosed,
+		Symbol: c.key.Symbol,
+		From:   day.AddDate(0, 0, -1).Format(closedTradingDay),
+		To:     day.AddDate(0, 0, 1).Format(closedTradingDay),
+		Limit:  closedLookupLimit,
+	}
+	lookupCtx, cancel := context.WithTimeout(ctx, closedLookupDeadline)
+	raws, err := execgw.ScanOrders(lookupCtx, d.Orders, query, closedLookupMaxPages)
+	cancel()
+	if err != nil {
+		if errors.Is(err, execgw.ErrTooManyPages) || errors.Is(err, execgw.ErrCursorLoop) {
+			return Snapshot{}, UnresolvedClosedListTruncated
+		}
+		return Snapshot{}, UnresolvedClosedListReadFailed
+	}
+
+	row, why := matchClosedRow(raws, c.order.OrderID)
+	if why != "" {
+		return Snapshot{}, why
+	}
+	rowSnap, err := parseSnapshot(row, single.ObservedAt, single.BrokerVisibleAt)
+	if err != nil {
+		// 체결 수량이 없거나 못 읽혀 파싱이 실패한 것이면 M6 사유로 가름(코드 리뷰 1 #3).
+		if !closedRowCarriesFill(row) {
+			return Snapshot{}, UnresolvedClosedListExecutionMissing
+		}
+		return Snapshot{}, UnresolvedClosedListRowUnreadable
+	}
+	rowSnap.AccountRef = single.AccountRef
+	if actual, complete := snapshotOrderKey(rowSnap); !complete || actual != c.key {
+		return Snapshot{}, UnresolvedClosedListScopeMismatch
+	}
+	if !closedRowCarriesFill(row) {
+		return Snapshot{}, UnresolvedClosedListExecutionMissing
+	}
+	derived := brokerstate.Derive(viewOf(rowSnap, c.order.Lineage))
+	if !derived.Terminal || derived.FailClosed {
+		return Snapshot{}, UnresolvedClosedListNotCleanTerminal
+	}
+	if !closedQuantityEqual(rowSnap.Quantity, single.Quantity) ||
+		!closedQuantityEqual(rowSnap.FilledQuantity, single.FilledQuantity) {
+		return Snapshot{}, UnresolvedClosedListQuantityDisagrees
+	}
+
+	// 상태 필드만 교체 — 수량·평균가·금액·체결 시각은 단건 것(원장 delta 는 직전 스냅숏 대비라 가격 출처가 중요함).
+	accepted := single
+	accepted.RawStatus = rowSnap.RawStatus
+	accepted.Canceled = rowSnap.Canceled
+	accepted.CanceledAt = rowSnap.CanceledAt
+	accepted.Derived = derived
+	return accepted, ""
+}
+
+// matchClosedRow 는 주문번호가 바이트 동일한 행 하나를 고름. raw 바이트가 같은 중복(페이지 경계)은 하나로 세고, 바이트가
+// 다른 같은 번호 행이 있으면 모호함. 번호를 못 읽는 행이 하나라도 있으면 결론 불가.
+func matchClosedRow(raws []json.RawMessage, orderID string) (json.RawMessage, UnresolvedReason) {
+	var match json.RawMessage
+	for _, raw := range raws {
+		var head struct {
+			OrderID *string `json:"orderId"`
+		}
+		if err := json.Unmarshal(unwrapResult(raw), &head); err != nil || head.OrderID == nil {
+			return nil, UnresolvedClosedListRowUnreadable
+		}
+		if *head.OrderID != orderID {
+			continue
+		}
+		if match == nil {
+			match = raw
+			continue
+		}
+		if !bytes.Equal(match, raw) {
+			return nil, UnresolvedClosedListAmbiguous
+		}
+	}
+	if match == nil {
+		return nil, UnresolvedClosedListNotFound
+	}
+	return match, ""
+}
+
+// closedRowCarriesFill 은 M6 — 행에 execution.filledQuantity 가 있고 유한한 십진수로 읽히는지 봄(값 0 허용).
+// 없으면 parseSnapshot 이 체결 0 으로 읽어 수량 일치가 표본 없이 참이 되므로 받지 않음. Q9 결과로 뒤집힐 수 있어 따로 둠.
+func closedRowCarriesFill(raw json.RawMessage) bool {
+	var row struct {
+		Execution *struct {
+			FilledQuantity *string `json:"filledQuantity"`
+		} `json:"execution"`
+	}
+	if err := json.Unmarshal(unwrapResult(raw), &row); err != nil || row.Execution == nil || row.Execution.FilledQuantity == nil {
+		return false
+	}
+	text := strings.TrimSpace(*row.Execution.FilledQuantity)
+	if text == "" {
+		return false
+	}
+	v, err := strconv.ParseFloat(text, 64)
+	return err == nil && !math.IsNaN(v) && !math.IsInf(v, 0)
+}
+
+// closedQuantityEqual 은 brokerstate 와 같은 상대 허용(1e-9)으로 두 수량을 비교함.
+func closedQuantityEqual(a, b float64) bool {
+	scale := math.Max(1, math.Max(math.Abs(a), math.Abs(b)))
+	return math.Abs(a-b) <= 1e-9*scale
+}
+
+// reportUnresolved 는 미해결이 이어진 후보를 한 번 알림. 브로커 주문번호·계좌·종목·수량·가격은 싣지 않음(Manager M1).
+// 조회와 별개의 2s context 로 감쌈(조회 시한이 지난 context 를 재사용하지 않음).
+func (d *Detector) reportUnresolved(ctx context.Context, c leftOpenCandidate, reason UnresolvedReason, lasted time.Duration) {
+	if d.Alerts == nil {
+		return
+	}
+	notifyCtx, cancel := context.WithTimeout(ctx, closedLookupDeadline)
+	defer cancel()
+	_ = d.Alerts.Notify(notifyCtx, obs.Event{
+		Type:  EventFillOrderUnresolved,
+		Title: "체결 감지: 미체결 목록을 떠난 주문의 종결을 확인하지 못함",
+		Body:  "단건 조회는 살아 있다고 하고 종결 목록으로도 확인되지 않음 — 대사 차단이 이어질 수 있음",
+		Fields: map[string]any{
+			obs.FieldIntentID:    c.order.IntentID,
+			obs.FieldMarket:      c.key.Market,
+			obs.FieldReason:      string(reason),
+			"unresolved_seconds": int64(lasted / time.Second),
+		},
+	})
+}
diff --git a/internal/filldetect/a191_closed_lookup_core_test.go b/internal/filldetect/a191_closed_lookup_core_test.go
new file mode 100644
index 000000000..aca305de2
--- /dev/null
+++ b/internal/filldetect/a191_closed_lookup_core_test.go
@@ -0,0 +1,239 @@
+package filldetect_test
+
+// a191 핵심 RED — 미체결 목록을 떠났는데 단건 조회가 「살아 있음(PENDING)」을 돌려주는 엔진 주문의 종결을 종결(CLOSED) 목록으로
+// 확인함. 이 파일은 base 의 공개 표면만 써서, base 에서는 컴파일되고 **행동으로** 실패하게 둠(종결이 안 쓰이고 추적이 남음).
+// 실제 저널 위에서 실제 Detector 를 돌림 — 브로커는 시험 더블(실주문 없음). 값은 전부 합성임(종목·주문번호·수량·가격).
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/JungHoonGhae/tossinvest-cli/internal/clock"
+	"github.com/JungHoonGhae/tossinvest-cli/internal/execgw"
+	"github.com/JungHoonGhae/tossinvest-cli/internal/filldetect"
+	"github.com/JungHoonGhae/tossinvest-cli/internal/journal"
+	"github.com/JungHoonGhae/tossinvest-cli/internal/reconcile"
+)
+
+// 합성 고정값 — 실제 종목·주문과 겹치지 않는 이름만 씀.
+const (
+	a191Symbol     = "SYN001"
+	a191Account    = "acct-1"
+	a191TradingDay = "2026-03-30"
+	a191OrderedAt  = "2026-03-30T10:00:00+09:00"
+)
+
+// a191Pager 는 상태 그룹(OPEN/CLOSED)을 가려 답하고 받은 질의를 전부 기록하는 가짜 목록 조회임.
+// 기존 fakePager 는 q.Status 를 보지 않으므로(커서로만 고름) CLOSED 질의를 단언할 수 없어 따로 둠.
+type a191Pager struct {
+	mu          sync.Mutex
+	open        execgw.OrderPage
+	closed      map[string]execgw.OrderPage // 커서 → 페이지
+	closedErr   error
+	blockClosed bool // CLOSED 질의가 ctx 가 끝날 때까지 멈춤(시한 시험용)
+	queries     []execgw.OrderQuery
+}
+
+func newA191Pager() *a191Pager {
+	return &a191Pager{closed: map[string]execgw.OrderPage{}}
+}
+
+func (p *a191Pager) OrdersPageRaw(ctx context.Context, q execgw.OrderQuery, cursor string) (execgw.OrderPage, error) {
+	p.mu.Lock()
+	p.queries = append(p.queries, q)
+	open, closedPage, closedErr, block := p.open, p.closed[cursor], p.closedErr, p.blockClosed
+	p.mu.Unlock()
+	switch q.Status {
+	case "OPEN":
+		return open, nil
+	case "CLOSED":
+		if block {
+			<-ctx.Done()
+			return execgw.OrderPage{}, ctx.Err()
+		}
+		if closedErr != nil {
+			return execgw.OrderPage{}, closedErr
+		}
+		return closedPage, nil
+	default:
+		return execgw.OrderPage{}, fmt.Errorf("a191Pager: unexpected status group %q", q.Status)
+	}
+}
+
+// closedQueries 는 받은 CLOSED 질의만 돌려줌.
+func (p *a191Pager) closedQueries() []execgw.OrderQuery {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	var out []execgw.OrderQuery
+	for _, q := range p.queries {
+		if q.Status == "CLOSED" {
+			out = append(out, q)
+		}
+	}
+	return out
+}
+
+func (p *a191Pager) setClosed(cursor string, pg execgw.OrderPage) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	p.closed[cursor] = pg
+}
+
+// a191Order 는 KR 합성 매도 주문 하나의 raw JSON 을 만듦.
+func a191Order(id, status, filled string) rawOrder {
+	return rawOrder{
+		id: id, symbol: a191Symbol, side: "SELL", currency: "KRW", orderedAt: a191OrderedAt,
+		status: status, quantity: "10", filled: filled,
+	}
+}
+
+// a191ClosedPage 는 CLOSED 질의의 단일 페이지임.
+func a191ClosedPage(rows ...json.RawMessage) execgw.OrderPage {
+	return execgw.OrderPage{Orders: rows}
+}
+
+// recordConfirmedA191Sell 은 엔진이 낸 합성 매도 intent 를 저널에 확정 상태로 둠.
+func recordConfirmedA191Sell(t *testing.T, j *journal.Journal, orderID string) {
+	t.Helper()
+	ctx := context.Background()
+	attempt, err := j.Prepare(ctx, journal.PrepareRequest{
+		Intent: journal.Intent{
+			ID: "intent-" + orderID, Market: "kr", TradingDay: a191TradingDay, AccountRef: a191Account,
+			Symbol: a191Symbol, Side: "SELL", OrderType: "LIMIT", Quantity: "10",
+			Price: "1", Currency: "KRW", Source: "engine", Fingerprint: "fp-" + orderID,
+		},
+		Kind: journal.KindPlace, AttemptID: "attempt-" + orderID,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := attempt.MarkDispatchStarted(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := attempt.MarkAcked(ctx, orderID); err != nil {
+		t.Fatal(err)
+	}
+	if err := attempt.Settle(ctx, journal.StateConfirmed, journal.ReasonBrokerAcknowledged, "acked"); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// a191JournalDetector 는 실제 저널·실제 Detector 위에 a191Pager 와 단건 조회 더블을 꽂음.
+func a191JournalDetector(t *testing.T, pager *a191Pager, reader *fakeOrderReader) (*filldetect.Detector, *journal.Journal, *clock.Fake) {
+	t.Helper()
+	clk := clock.NewFake(pollStart)
+	j := openLedgerJournal(t, clk, filepath.Join(t.TempDir(), "journal.db"))
+	return &filldetect.Detector{
+		Orders:    pager,
+		Order:     reader,
+		Positions: &fakePositions{},
+		Tracked:   filldetect.JournalTracked{Journal: j, AccountRef: a191Account},
+		Ledger:    filldetect.JournalLedger{Journal: j, AccountRef: a191Account},
+		Clock:     clk,
+	}, j, clk
+}
+
+// TestA191OrderThatLeftTheOpenListAndIsCanceledInTheClosedListIsRecordedTerminal (tasks 3.1) — 결함 그대로의 입력:
+// OPEN 에 없음 + 단건 PENDING·취소 시각 없음·체결 0 + CLOSED 에 같은 주문 CANCELED·체결 0 → 종결 CANCELLED, 추적 종료.
+func TestA191OrderThatLeftTheOpenListAndIsCanceledInTheClosedListIsRecordedTerminal(t *testing.T) {
+	pager := newA191Pager()
+	pager.setClosed("", a191ClosedPage(a191Order("o-a191-1", "CANCELED", "0").json()))
+	reader := &fakeOrderReader{orders: rawOrders(a191Order("o-a191-1", "PENDING", "0"))}
+	d, j, _ := a191JournalDetector(t, pager, reader)
+	ctx := context.Background()
+	recordConfirmedA191Sell(t, j, "o-a191-1")
+
+	cycle, err := d.PollOnce(ctx)
+	if err != nil {
+		t.Fatalf("poll: %v", err)
+	}
+	if len(cycle.FailedClosed) != 0 {
+		t.Fatalf("FailedClosed = %v, want none", cycle.FailedClosed)
+	}
+	snap, err := j.LookupFill(ctx, "o-a191-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !snap.Terminal || snap.State != "CANCELLED" || snap.FilledQuantity != "0" {
+		t.Fatalf("snapshot = %+v, want terminal CANCELLED with 0 filled", snap)
+	}
+	tracked, err := filldetect.JournalTracked{Journal: j, AccountRef: a191Account}.TrackedOrders(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(tracked) != 0 {
+		t.Fatalf("tracked after the terminal snapshot = %+v, want none", tracked)
+	}
+}
+
+// TestA191TerminalSnapshotLeavesTheReconcileLocalState (tasks 3.2) — 같은 흐름 뒤 대사의 로컬 열린 주문에서도 빠짐
+// (missing-order 의 원천이 사라짐).
+func TestA191TerminalSnapshotLeavesTheReconcileLocalState(t *testing.T) {
+	pager := newA191Pager()
+	pager.setClosed("", a191ClosedPage(a191Order("o-a191-2", "CANCELED", "0").json()))
+	reader := &fakeOrderReader{orders: rawOrders(a191Order("o-a191-2", "PENDING", "0"))}
+	d, j, _ := a191JournalDetector(t, pager, reader)
+	ctx := context.Background()
+	recordConfirmedA191Sell(t, j, "o-a191-2")
+
+	before, err := reconcile.LocalStateFromJournal(ctx, j, a191Account)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(before.OpenOrders) != 1 {
+		t.Fatalf("local open orders before the poll = %d, want 1 (the confirmed order)", len(before.OpenOrders))
+	}
+	if _, err := d.PollOnce(ctx); err != nil {
+		t.Fatalf("poll: %v", err)
+	}
+	after, err := reconcile.LocalStateFromJournal(ctx, j, a191Account)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(after.OpenOrders) != 0 || len(after.ScopedOpenOrders) != 0 {
+		t.Fatalf("local open orders after the terminal snapshot = %+v, want none", after.OpenOrders)
+	}
+}
+
+// TestA191AcceptedClosedRowKeepsTheSingleReadExecution (tasks 3.4b, 변이 m19) — 받아들일 때 바뀌는 것은 상태뿐임.
+// 원장 직전 0 → 단건 PARTIAL_FILLED 4(평균가 1) + CLOSED CANCELED 4(평균가 2) → 체결 4 가 **단건 평균가**로 기록되고 종결.
+func TestA191AcceptedClosedRowKeepsTheSingleReadExecution(t *testing.T) {
+	pager := newA191Pager()
+	closedRow := a191Order("o-a191-3", "CANCELED", "4")
+	closedRow.avgPrice = "2"
+	closedRow.canceled = "2026-03-30T10:05:00+09:00"
+	pager.setClosed("", a191ClosedPage(closedRow.json()))
+	single := a191Order("o-a191-3", "PARTIAL_FILLED", "4")
+	single.avgPrice = "1"
+	reader := &fakeOrderReader{orders: rawOrders(single)}
+	d, j, _ := a191JournalDetector(t, pager, reader)
+	ctx := context.Background()
+	recordConfirmedA191Sell(t, j, "o-a191-3")
+
+	cycle, err := d.PollOnce(ctx)
+	if err != nil {
+		t.Fatalf("poll: %v", err)
+	}
+	if cycle.Fills != 1 {
+		t.Fatalf("fills = %d, want 1 (the single read's 4 against an empty ledger)", cycle.Fills)
+	}
+	snap, err := j.LookupFill(ctx, "o-a191-3")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !snap.Terminal || snap.State != "CANCELLED_PARTIALLY_FILLED" || snap.FilledQuantity != "4" || snap.AveragePrice != "1" {
+		t.Fatalf("snapshot = %+v, want terminal CANCELLED_PARTIALLY_FILLED, 4 filled at the single read's average 1", snap)
+	}
+}
+
+// errA191Throttled 는 CLOSED 질의 실패를 흉내 냄.
+var errA191Throttled = errors.New("a191: closed list throttled")
+
+// a191Since 는 시험 시계 기준 경과를 한 줄로 씀(가독성용).
+func a191Since(clk *clock.Fake, from time.Time) time.Duration { return clk.Now().Sub(from) }
diff --git a/internal/filldetect/a191_closed_lookup_test.go b/internal/filldetect/a191_closed_lookup_test.go
new file mode 100644
index 000000000..883cfebf2
--- /dev/null
+++ b/internal/filldetect/a191_closed_lookup_test.go
@@ -0,0 +1,619 @@
+package filldetect_test
+
+// a191 수용 조건·발동 조건·간격·시한·알림의 시험 — 시험 더블(a191Pager·fakeLedger) 위에서 Detector 를 돌림.
+// 모든 값은 합성임. 모든 시험이 a191Pager 가 받은 질의를 단언함(기존 fakePager 는 status 를 안 봐 우발 CLOSED 질의를 못 잡음).
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/JungHoonGhae/tossinvest-cli/internal/clock"
+	"github.com/JungHoonGhae/tossinvest-cli/internal/execgw"
+	"github.com/JungHoonGhae/tossinvest-cli/internal/filldetect"
+	"github.com/JungHoonGhae/tossinvest-cli/internal/obs"
+)
+
+// a191Alerts 는 알림 통로를 기록함.
+type a191Alerts struct {
+	mu     sync.Mutex
+	events []obs.Event
+}
+
+func (a *a191Alerts) Notify(_ context.Context, e obs.Event) error {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.events = append(a.events, e)
+	return nil
+}
+
+func (a *a191Alerts) all() []obs.Event {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return append([]obs.Event(nil), a.events...)
+}
+
+// a191Tracked 는 합성 추적 주문 하나임(KR, 매도, 거래일 a191TradingDay).
+func a191Tracked(id string) filldetect.TrackedOrder {
+	return filldetect.TrackedOrder{
+		OrderID: id, IntentID: "intent-" + id, AccountRef: "acct-test",
+		Symbol: a191Symbol, Market: "kr", TradingDay: a191TradingDay, Side: "SELL",
+	}
+}
+
+// a191FakeOrder 는 fakeTracked 의 기본 계좌(acct-test)와 맞는 합성 주문임.
+func a191FakeOrder(id, status, filled string) rawOrder { return a191Order(id, status, filled) }
+
+func a191Fake(t *testing.T, pager *a191Pager, reader *fakeOrderReader, tracked ...filldetect.TrackedOrder) (*filldetect.Detector, *clock.Fake, *fakeLedger, *a191Alerts) {
+	t.Helper()
+	clk := clock.NewFake(pollStart)
+	ledger := newLedger(clk)
+	alerts := &a191Alerts{}
+	return &filldetect.Detector{
+		Orders: pager, Order: reader, Positions: &fakePositions{},
+		Tracked: fakeTracked{orders: tracked}, Ledger: ledger, Clock: clk, Alerts: alerts,
+	}, clk, ledger, alerts
+}
+
+func a191Poll(t *testing.T, d *filldetect.Detector) filldetect.Cycle {
+	t.Helper()
+	cycle, err := d.PollOnce(context.Background())
+	if err != nil {
+		t.Fatalf("poll: %v", err)
+	}
+	return cycle
+}
+
+func lastApplied(t *testing.T, l *fakeLedger, id string) filldetect.Snapshot {
+	t.Helper()
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	for i := len(l.applied) - 1; i >= 0; i-- {
+		if l.applied[i].OrderID == id {
+			return l.applied[i]
+		}
+	}
+	t.Fatalf("no snapshot applied for %s", id)
+	return filldetect.Snapshot{}
+}
+
+func reasonsOf(c filldetect.Cycle) map[string]filldetect.UnresolvedReason {
+	out := map[string]filldetect.UnresolvedReason{}
+	for _, u := range c.Unresolved {
+		out[u.OrderID] = u.Reason
+	}
+	return out
+}
+
+// TestA191SingleReadPendingAndClosedListSilentKeepsTodaysSnapshot (3.3) — 못 찾음 → 오늘과 같은 단건 스냅숏, 사유 남음, 실패·래치 없음.
+func TestA191SingleReadPendingAndClosedListSilentKeepsTodaysSnapshot(t *testing.T) {
+	pager := newA191Pager()
+	reader := &fakeOrderReader{orders: rawOrders(a191FakeOrder("o-1", "PENDING", "0"))}
+	d, _, ledger, _ := a191Fake(t, pager, reader, a191Tracked("o-1"))
+	cycle := a191Poll(t, d)
+	if got := lastApplied(t, ledger, "o-1"); got.Derived.State != "OPEN_UNFILLED" || got.RawStatus != "PENDING" {
+		t.Fatalf("applied = %+v, want today's OPEN_UNFILLED single read", got.Derived)
+	}
+	if len(cycle.FailedClosed) != 0 || cycle.ClosedReads != 1 {
+		t.Fatalf("cycle = %+v, want one CLOSED lookup and no fail-closed", cycle)
+	}
+	if r := reasonsOf(cycle)["o-1"]; r != filldetect.UnresolvedClosedListNotFound {
+		t.Fatalf("reason = %q, want %q", r, filldetect.UnresolvedClosedListNotFound)
+	}
+}
+
+// TestA191ClosedListFillDisagreementNeverRecordsAFill (3.4, m6·m7·m16) — 체결 수량·주문 수량 불일치는 받지 않음.
+// 단건 0 → CLOSED >0(증가 방향) 이라 m16 이 감소 가드에 가려지지 않음.
+func TestA191ClosedListFillDisagreementNeverRecordsAFill(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		row  rawOrder
+	}{
+		{"filled differs", a191FakeOrder("o-2", "FILLED", "10")},
+		{"ordered quantity differs", func() rawOrder { o := a191FakeOrder("o-2", "CANCELED", "0"); o.quantity = "9"; return o }()},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			pager := newA191Pager()
+			pager.setClosed("", a191ClosedPage(tc.row.json()))
+			reader := &fakeOrderReader{orders: rawOrders(a191FakeOrder("o-2", "PENDING", "0"))}
+			d, _, ledger, _ := a191Fake(t, pager, reader, a191Tracked("o-2"))
+			cycle := a191Poll(t, d)
+			got := lastApplied(t, ledger, "o-2")
+			if got.Derived.Terminal || got.FilledQuantity != 0 || got.Quantity != 10 || cycle.Fills != 0 {
+				t.Fatalf("applied = %+v (fills %d), want the single read untouched", got, cycle.Fills)
+			}
+			if r := reasonsOf(cycle)["o-2"]; r != filldetect.UnresolvedClosedListQuantityDisagrees {
+				t.Fatalf("reason = %q", r)
+			}
+		})
+	}
+}
+
+// TestA191ClosedListReadFailureDoesNotFailTheCycle (3.5, m10) — CLOSED 실패는 주기를 안 깨고 같은 주기 재조회 없음.
+func TestA191ClosedListReadFailureDoesNotFailTheCycle(t *testing.T) {
+	pager := newA191Pager()
+	pager.closedErr = errA191Throttled
+	reader := &fakeOrderReader{orders: rawOrders(a191FakeOrder("o-3", "PENDING", "0"))}
+	d, _, ledger, _ := a191Fake(t, pager, reader, a191Tracked("o-3"))
+	cycle := a191Poll(t, d)
+	if len(pager.closedQueries()) != 1 {
+		t.Fatalf("CLOSED queries = %d, want exactly 1 (no same-cycle retry)", len(pager.closedQueries()))
+	}
+	if got := lastApplied(t, ledger, "o-3"); got.Derived.State != "OPEN_UNFILLED" {
+		t.Fatalf("applied = %+v", got.Derived)
+	}
+	if r := reasonsOf(cycle)["o-3"]; r != filldetect.UnresolvedClosedListReadFailed {
+		t.Fatalf("reason = %q", r)
+	}
+}
+
+// TestA191ClosedLookupIsThrottledPerOrder (3.6, m11) — 첫 조회 즉시, 30s 안 0회, 30s 뒤 1회.
+func TestA191ClosedLookupIsThrottledPerOrder(t *testing.T) {
+	pager := newA191Pager()
+	reader := &fakeOrderReader{orders: rawOrders(a191FakeOrder("o-4", "PENDING", "0"))}
+	d, clk, _, _ := a191Fake(t, pager, reader, a191Tracked("o-4"))
+	a191Poll(t, d)
+	clk.Advance(3 * time.Second)
+	cycle := a191Poll(t, d)
+	if n := len(pager.closedQueries()); n != 1 {
+		t.Fatalf("CLOSED queries after 3s = %d, want 1", n)
+	}
+	if r := reasonsOf(cycle)["o-4"]; r != filldetect.UnresolvedClosedLookupDeferred {
+		t.Fatalf("reason inside the interval = %q", r)
+	}
+	clk.Advance(27 * time.Second)
+	a191Poll(t, d)
+	if n := len(pager.closedQueries()); n != 2 {
+		t.Fatalf("CLOSED queries after 30s = %d, want 2", n)
+	}
+}
