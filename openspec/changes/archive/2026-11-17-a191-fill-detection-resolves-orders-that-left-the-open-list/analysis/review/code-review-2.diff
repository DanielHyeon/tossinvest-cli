+// TestA191OnlyOneClosedLookupPerCycle (3.12a, m23·m26 — M8 ②) — 후보 셋이 세 주기에 걸쳐 하나씩, 미뤄진 것의 lastLookup 은 그대로.
+func TestA191OnlyOneClosedLookupPerCycle(t *testing.T) {
