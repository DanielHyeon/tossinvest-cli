+	}{
+		{"canceled first", []json.RawMessage{canceled, partial}, filldetect.UnresolvedClosedListAmbiguous},
+		{"partial first", []json.RawMessage{partial, canceled}, filldetect.UnresolvedClosedListAmbiguous},
+	} {
