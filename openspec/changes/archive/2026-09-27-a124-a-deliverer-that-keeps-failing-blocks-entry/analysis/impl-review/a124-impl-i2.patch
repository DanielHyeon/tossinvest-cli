+// Q5: 잘린 나열에 없다는 것은 PENDING 이탈의 증거가 아니다 — 거기서 계수를 지우면 한도 층으로 밀린 행의
+// 연속이 사라진다.
+func TestATruncatedListingDoesNotForgetARun(t *testing.T) {
