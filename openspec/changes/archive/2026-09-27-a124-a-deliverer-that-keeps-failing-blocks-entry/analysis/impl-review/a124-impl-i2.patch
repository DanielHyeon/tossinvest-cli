+	f.rowTitled(t, "a124-4.1-trunc-b", "B-row")
+	f.cycles(t, 1) // 나열 = [B] (잘림), B 는 전달됨
+	f.cycles(t, 1) // 나열 = [A] — 기록 실패 3 번째
