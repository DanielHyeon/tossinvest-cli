+// a124AtStage 는 판정 단계 훅에서 한 번만 fn 을 부른다.
+func a124AtStage(d *alertDeliverer, stage alertJudgeStage, fn func()) {
+	var once sync.Once
+	d.judgeHook = func(s alertJudgeStage, _ int64) {
+		if s == stage {
+			once.Do(fn)
+		}
+	}
+}
