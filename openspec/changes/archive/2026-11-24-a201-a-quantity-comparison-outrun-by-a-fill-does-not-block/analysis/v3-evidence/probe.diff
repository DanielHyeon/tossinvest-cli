@@ -0,0 +1,37 @@
+package reconcile
+
+import (
+	"os"
+	"strings"
+)
+
+var _ = os.Getenv
+
+// ProbeStaleMarks 는 표지 사본(탐침 로그용).
+func (t *Tracker) ProbeStaleMarks() map[string]string {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	out := map[string]string{}
+	for k, v := range t.probeStale {
+		out[k] = v
+	}
+	return out
+}
+
+// PROBE v3(scratch 전용): 「체결이 지나간 비교로 선 수량 불일치」 표지.
+//
+// RunOnce 가 Observe 뒤에 부름. 그 종목에 수량 블록(QM · adjusted_reconcile)이 서 있을 때만 표지 — 블록 없으면 무시.
+func (t *Tracker) ProbeMarkStaleQuantity(comparison string, symbols ...string) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.probeStale == nil {
+		t.probeStale = map[string]string{}
+	}
+	for _, symbol := range symbols {
+		key := strings.ToUpper(strings.TrimSpace(symbol))
+		if key == "" || !hasBlockFor(t.blocks, key) {
+			continue
+		}
+		t.probeStale[key] = strings.TrimSpace(comparison)
+	}
+}
