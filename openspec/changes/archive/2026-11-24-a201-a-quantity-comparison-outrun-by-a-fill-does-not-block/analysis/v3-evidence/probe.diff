+func (w *a201World) probeExpectReleased(symbol, cause string) {
+	w.t.Helper()
+	found := false
+	for _, r := range w.rows(symbol) {
+		if r == "QUANTITY_MISMATCH|released:"+cause {
+			found = true
+		}
+	}
+	if !found || len(w.activeCauses(symbol)) != 0 {
+		w.t.Fatalf("rows(%s) = %q, want released:%s and nothing active", symbol, w.rows(symbol), cause)
+	}
+}
+
+func TestA201V3ProbeW2(t *testing.T) {
+	const symbol = "SYN201"
+	w := newA201World(t)
+	w.start(symbol)
+	w.converge.at = a201BeforePositions
+	w.converge.fire = func() { w.stopFills(symbol, "31") }
+	c := w.next()
+	w.logCycle("W2 주기(표지)", symbol, c)
+	w.assertStuck(symbol)
+	c = w.next()
+	w.logCycle("다음 깨끗한 주기", symbol, c)
+	w.probeExpectReleased(symbol, "RECHECK_MATCHED")
+	w.holds(symbol, "5", "100", 100)
+	c = w.next()
+	w.logCycle("재매수 주기", symbol, c)
+	if c.Adopted != 1 {
+		t.Fatalf("rebuy adopted = %d, want 1", c.Adopted)
+	}
+}
