+func TestA201V3ProbeEarlierCreditW2(t *testing.T) {
+	const symbol = "SYN201"
+	w := newA201World(t)
+	w.start(symbol)
+	w.holds(symbol, "20", "100", 100)
+	w.stopOpenAtBroker(symbol, "31")
+	c := w.next()
+	w.logCycle("외부 매도 주기(로컬 31 · 계좌 20)", symbol, c)
+	w.accountSold()
+	w.converge.at = a201BeforePositions
+	w.converge.fire = func() { w.stopFills(symbol, "20") }
+	c = w.next()
+	w.logCycle("W2 주기(로컬 20 · 계좌 0, 표지 · 크레딧 반박)", symbol, c)
+	if c.Released != 0 {
+		t.Fatalf("stale cycle released %d", c.Released)
+	}
+	c = w.next()
+	w.logCycle("다음 깨끗한 주기", symbol, c)
+	w.probeExpectReleased(symbol, "RECHECK_MATCHED")
+}
