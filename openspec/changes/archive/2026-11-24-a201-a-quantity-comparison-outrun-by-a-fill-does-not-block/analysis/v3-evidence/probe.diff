+// R1-1(codex r1): 앞 조정으로 로컬 · 계좌 20, 크레딧 · QM 활성 → 사람 5 주 매도(스냅숏 15 · 로컬 읽기 20) →
+// 스냅숏 뒤 엔진 매도 5 주 체결이 로컬 읽기 뒤 · 조정 tx 전에 커밋(실제 계좌 10 · 로컬 15) → 조정 stale.
+func TestA201V3ProbeR11(t *testing.T) {
+	const symbol = "SYN201"
+	w := newA201World(t)
+	w.start(symbol) // 계좌 0 · 열린 주문 0 으로 비움(로컬 31)
+	// 앞 주기: 사람의 앱 매도 11 주 → 로컬 31 · 계좌 20 → 수렴 31→20, 크레딧 · QM.
+	w.holds(symbol, "20", "100", 100)
+	w.stopOpenAtBroker(symbol, "31")
+	c := w.next()
+	w.logCycle("앞 주기(수렴 31→20 · QM · 크레딧)", symbol, c)
+	if c.Converged != 1 {
+		t.Fatalf("setup cycle = %+v", c)
+	}
+	// 엔진의 별도 매도 5 주(접수 확정, 브로커 열린 목록에 있음).
+	w.confirm(reconcileAccount, symbol, "SELL", "o-sell5")
+	w.clk.Advance(time.Second)
+	// 사람의 앱 매도 5 주 → 스냅숏 15. 열린 주문: o-stop 31 · o-sell5 5.
+	w.holdings.items = nil
+	w.orders.orders = nil
+	w.holds(symbol, "15", "100", 100)
+	w.stopOpenAtBroker(symbol, "31")
+	w.orders.orders = append(w.orders.orders, []byte(`{"orderId":"o-sell5","market":"kr","orderDate":"`+a201Day+
+		`","symbol":"`+symbol+`","side":"SELL","status":"OPEN","quantity":"5","price":"100"}`))
+	// 스냅숏 뒤 · 로컬 읽기 뒤 · 조정 tx 전에 엔진 매도 5 주 체결(W2 자리).
+	w.converge.at = a201BeforePositions
+	w.converge.fire = func() { w.fill(reconcileAccount, symbol, "o-sell5", "SELL", "5") }
+	c = w.next()
+	w.logCycle("R1-1 주기 k(스냅숏 15 · 로컬 읽기 20 · 체결 뒤 로컬 15)", symbol, c)
+	t.Logf("marks after k = %v", w.tracker.ProbeStaleMarks())
+	if !w.converge.fired {
+		t.Fatal("fill hook never ran")
+	}
+	if c.Released != 0 {
+		t.Fatalf("cycle k released %d", c.Released)
+	}
+	// 다음 주기: 실제 계좌 10 · 로컬 15. o-sell5 는 체결로 목록에서 사라짐.
+	w.holdings.items = nil
+	w.orders.orders = nil
+	w.holds(symbol, "10", "100", 100)
+	w.stopOpenAtBroker(symbol, "31")
+	c = w.next()
+	w.logCycle("주기 k+1(스냅숏 10 · 로컬 15)", symbol, c)
+	t.Logf("marks after k+1 = %v", w.tracker.ProbeStaleMarks())
+	if c.Released != 0 || len(w.activeCauses(symbol)) != 1 {
+		t.Fatalf("cycle k+1 = %+v rows=%q, want no release and the QM row active", c, w.rows(symbol))
+	}
+	c = w.next()
+	w.logCycle("주기 k+2(스냅숏 10 · 로컬 10)", symbol, c)
+	c = w.next()
+	w.logCycle("주기 k+3", symbol, c)
+}
