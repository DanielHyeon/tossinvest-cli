+package engine_test
+
+// scratch 탐침 — v3 체결 credit(조정 credit 맵 공유 + 원인 표지)의 모양으로 (q2)(q6)(q7)을 봄. 단언은 관측만.
+
+import (
+	"testing"
+)
+
+func (w *a201World) credits(label string) {
+	a, f := w.tracker.ProbeCredits()
+	w.t.Logf("  [%s] adjusted=%v filled=%v", label, a, f)
+}
+
+func TestA201V3ShapeW2(t *testing.T) {
+	const symbol = "SYN201"
+	w := newA201World(t)
+	w.start(symbol)
+	w.converge.at = a201BeforePositions
+	w.converge.fire = func() { w.stopFills(symbol, "31") }
+	c := w.next()
+	w.logCycle("W2 주기", symbol, c)
+	w.credits("W2 뒤")
+	for i := 0; i < 2; i++ {
+		c = w.next()
+		w.logCycle("다음 주기", symbol, c)
+		w.credits("다음 뒤")
+	}
+}
+
+func TestA201V3ShapeEarlierCreditW2(t *testing.T) {
+	const symbol = "SYN201"
+	w := newA201World(t)
+	w.start(symbol)
+	w.holds(symbol, "20", "100", 100)
+	w.orders.orders = nil
+	w.stopOpenAtBroker(symbol, "31")
+	c := w.next()
+	w.logCycle("외부 매도 주기", symbol, c)
+	w.credits("외부 매도 뒤")
+	w.accountSold()
+	w.converge.at = a201BeforePositions
+	w.converge.fire = func() { w.stopFills(symbol, "20") }
+	c = w.next()
+	w.logCycle("W2 주기", symbol, c)
+	w.credits("W2 뒤")
+	c = w.next()
+	w.logCycle("다음 주기", symbol, c)
+	w.credits("다음 뒤")
+}
+
+// (q6) W4: 수렴이 31→0 조정을 커밋한 뒤 Refresh 때 엔진 매도 체결.
+func TestA201V3ShapeW4(t *testing.T) {
+	const symbol = "SYN201"
+	w := newA201World(t)
+	w.start(symbol)
+	w.store.armed = true
+	w.store.fire = func() { w.stopFills(symbol, "31") }
+	c := w.next()
+	w.logCycle("W4 주기", symbol, c)
+	w.credits("W4 뒤")
+	for i := 0; i < 2; i++ {
+		c = w.next()
+		w.logCycle("다음 주기", symbol, c)
+		w.credits("다음 뒤")
+	}
+}
+
+// (q7) 이 프로세스가 missing-order 로 삽입 · 결속한 행 위에 나중 수량 불일치(W2).
+func TestA201V3ShapeA192BoundRow(t *testing.T) {
+	const symbol = "SYN201"
+	w := newA201World(t)
+	w.tracker.Terminal = w.journal
+	w.hold(symbol, "31")
+	w.holds(symbol, "31", "100", 100)
+	w.orders.orders = nil // 엔진 매도가 계좌 열린 목록에 없음 → missing-order
+	c := w.next()
+	w.logCycle("missing-order 주기(결속)", symbol, c)
+	w.t.Logf("  hold reasons=%v", w.tracker.OrderTerminalHoldReasons())
+	w.accountSold()
+	w.converge.at = a201BeforePositions
+	w.converge.fire = func() { w.stopFills(symbol, "31") }
+	c = w.next()
+	w.logCycle("W2 주기(같은 행 위 수량 불일치)", symbol, c)
+	w.t.Logf("  hold reasons=%v", w.tracker.OrderTerminalHoldReasons())
+	w.credits("W2 뒤")
+	for i := 0; i < 2; i++ {
+		c = w.next()
+		w.logCycle("다음 주기", symbol, c)
+		w.t.Logf("  hold reasons=%v", w.tracker.OrderTerminalHoldReasons())
+	}
+}
+
+// 나중 비교가 그 종목을 분쟁으로 보면 credit 소멸 — 그 뒤 깨끗해져도 안 풀림.
+func TestA201V3ShapeLaterDisputeRefutes(t *testing.T) {
+	const symbol = "SYN201"
+	w := newA201World(t)
+	w.start(symbol)
+	w.converge.at = a201BeforePositions
+	w.converge.fire = func() { w.stopFills(symbol, "31") }
+	c := w.next()
+	w.logCycle("W2 주기", symbol, c)
+	w.credits("W2 뒤")
+	w.holds(symbol, "5", "100", 100) // 사람 재매수 → 외부 포지션(분쟁)
+	c = w.next()
+	w.logCycle("외부 포지션 주기", symbol, c)
+	w.credits("외부 포지션 뒤")
+	w.holdings.items = nil
+	c = w.next()
+	w.logCycle("다시 비움 주기", symbol, c)
+	w.credits("다시 비움 뒤")
+}
