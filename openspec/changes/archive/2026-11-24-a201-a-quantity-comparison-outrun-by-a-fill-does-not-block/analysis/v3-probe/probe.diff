@@ -0,0 +1,85 @@
+package reconcile
+
+// scratch 탐침 — v3 체결 credit 의 최소 모양.
+
+import (
+	"context"
+	"strings"
+
+	"github.com/JungHoonGhae/tossinvest-cli/internal/journal"
+)
+
+type FillMark struct {
+	id    int64
+	known bool
+}
+
+func MarkBeforeLocalRead(ctx context.Context, j *journal.Journal) FillMark {
+	if j == nil {
+		return FillMark{}
+	}
+	id, err := j.MaxFillEventID(ctx)
+	if err != nil {
+		return FillMark{}
+	}
+	return FillMark{id: id, known: true}
+}
+
+func FillOutranSymbols(ctx context.Context, j *journal.Journal, mark FillMark, diff Diff, converged ConvergeReport) []string {
+	if j == nil || !mark.known {
+		return nil
+	}
+	adjusted := map[string]bool{}
+	for _, c := range converged.Converged {
+		adjusted[strings.ToUpper(strings.TrimSpace(c.Symbol))] = true
+	}
+	var out []string
+	for _, m := range diff.Quantities {
+		s := strings.ToUpper(strings.TrimSpace(m.Symbol))
+		if s == "" || adjusted[s] {
+			continue
+		}
+		w, err := j.FillWatermark(ctx, s)
+		if err != nil || w <= mark.id {
+			continue
+		}
+		out = append(out, s)
+	}
+	return out
+}
+
+func (t *Tracker) FillsOutranAdjustment(comparison string, symbols ...string) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.adjusted == nil {
+		t.adjusted = map[string]string{}
+	}
+	if t.filled == nil {
+		t.filled = map[string]string{}
+	}
+	for s, stamp := range t.filled {
+		if t.adjusted[s] != stamp {
+			delete(t.filled, s)
+		}
+	}
+	for _, s := range symbols {
+		if !hasBlockFor(t.blocks, s) {
+			continue
+		}
+		t.adjusted[s] = strings.TrimSpace(comparison)
+		t.filled[s] = strings.TrimSpace(comparison)
+	}
+}
+
+func (t *Tracker) ProbeCredits() (map[string]string, map[string]string) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	a, f := map[string]string{}, map[string]string{}
+	for k, v := range t.adjusted {
+		a[k] = v
+	}
+	for k, v := range t.filled {
+		f[k] = v
+	}
+	return a, f
+}
