diff --git a/internal/reconcile/a201_probe.go b/internal/reconcile/a201_probe.go
new file mode 100644
index 000000000..6d2e940e0
--- /dev/null
+++ b/internal/reconcile/a201_probe.go
@@ -0,0 +1,62 @@
+package reconcile
+
+// a201 1.5 (e)(f) 탐침 — scratch 사본 전용. 추적 파일 아님. design D3 의 세 조건을 최소로 흉내 냄.
+
+import (
+	"context"
+	"os"
+	"strings"
+
+	"github.com/JungHoonGhae/tossinvest-cli/internal/journal"
+)
+
+// ProbeRejudge 는 diff 에서 (가)(나)(다)를 만족하는 수량 불일치를 뺀 사본을 돌려줌. PROBE_D5=1 이면 그 종목의 missing-order 중
+// 다시 읽은 로컬에서 추적 대상이 아닌 것도 뺌.
+func ProbeRejudge(ctx context.Context, j *journal.Journal, account string, diff Diff, before int64,
+	adjusted map[string]bool) (Diff, []string) {
+	held, err := HeldBySymbol(ctx, j, account)
+	if err != nil {
+		return diff, nil
+	}
+	var dropped []string
+	kept := make([]QuantityMismatch, 0, len(diff.Quantities))
+	for _, m := range diff.Quantities {
+		symbol := strings.ToUpper(strings.TrimSpace(m.Symbol))
+		wm, err := j.FillWatermark(ctx, symbol)
+		if err != nil || wm <= before || adjusted[symbol] {
+			kept = append(kept, m)
+			continue
+		}
+		local, present := held[symbol]
+		reread, ok := canonicalPresentQuantity(local, present)
+		if !ok || !quantitiesAgree(reread, m.Broker) {
+			kept = append(kept, m)
+			continue
+		}
+		dropped = append(dropped, symbol)
+	}
+	out := diff
+	out.Quantities = kept
+	if os.Getenv("PROBE_D5") == "1" && len(dropped) > 0 {
+		tracked, err := j.TrackedFillOrders(ctx, account)
+		if err == nil {
+			live := map[string]bool{}
+			for _, t := range tracked {
+				live[t.OrderID] = true
+			}
+			drop := map[string]bool{}
+			for _, s := range dropped {
+				drop[s] = true
+			}
+			var missing []LocalOrder
+			for _, o := range diff.MissingOrders {
+				if drop[strings.ToUpper(o.Symbol)] && !live[o.OriginalOrderID] {
+					continue
+				}
+				missing = append(missing, o)
+			}
+			out.MissingOrders = missing
+		}
+	}
+	return out, dropped
+}
