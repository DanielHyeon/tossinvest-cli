+			srv, _ := interlockServer(t, tc.account)
+			eng, err := openGateWithGuardianOptions(t, dir, srv, false, nil)
+			if err == nil || eng != nil {
+				t.Fatalf("start = (%v, %v), want a refusal", eng != nil, err)
