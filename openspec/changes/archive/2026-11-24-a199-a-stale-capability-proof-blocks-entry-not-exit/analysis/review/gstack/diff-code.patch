   "internal/app/engine/engine.go||NewOrderPath": "func NewOrderPath(opts Options) (*OrderPath, error) {\n\tgetenv := opts.Getenv\n\tif getenv == nil {\n\t\tgetenv = os.Getenv\n\t}\n\n\tpaths, err := apppaths.Resolve(opts.ConfigDir, \"\")\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tcfg, err := config.NewService(paths.ConfigFile).Load(context.Background())\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\n\tcredFile, tokenFile, err := apppaths.OpenAPI(opts.ConfigDir)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tcreds, err := official.LoadCredentials(getenv, credFile)\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"loading official credentials: %w\", err)\n\t}\n\n\tif creds == nil || creds.APIKey == \"\" || creds.SecretKey == \"\" {\n\t\treturn nil, ErrOfficialCredentialsRequired\n\t}\n\n\tvar off *official.Client\n\tif opts.BudgetFactory == nil {\n\t\toff = official.New(*creds, tokenFile, opts.OfficialOptions...)\n\t} else {\n\t\toff, err = opts.BudgetFactory.NewClient(*creds, tokenFile, opts.OfficialOptions...)\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t}\n\tbroker := \u0026officialBroker{off: off}\n\n\treturn \u0026OrderPath{\n\t\tPaths:       paths,\n\t\tConfig:      cfg,\n\t\tTokenFile:   tokenFile,\n\t\tOfficial:    off,\n\t\tTrading:     trading.NewService(cfg.Trading, broker).WithConditional(broker),\n\t\tofficial:    off,\n\t\tbroker:      broker,\n\t\tconditional: broker,\n\t}, nil\n}",
   "internal/app/engine/gateway.go||buildGateway": "func buildGateway(ctx context.Context, in gatewayInputs) (engineWiring, error) {\n\n\tif err := checkProjectionWired(in.journal); err != nil {\n\t\treturn engineWiring{}, err\n\t}\n\n\torders := execgw.OfficialOrders{Client: in.official}\n\taccount := execgw.OfficialAccount{Client: in.official}\n\n\tentry := execgw.NewEntryGate(in.clock, nil)\n\n\ttracker := \u0026reconcile.Tracker{\n\t\tClock:      in.clock,\n\t\tGate:       entry,\n\t\tJournal:    in.journal,\n\t\tAccountRef: in.accountRef,\n\n\t\tTerminal: in.journal,\n\t}\n\tif err := tracker.Restore(ctx); err != nil {\n\t\treturn engineWiring{}, fmt.Errorf(\"engine: restoring the RECONCILE projection: %w\", err)\n\t}\n\n\tif err := restoreAlertEntryLatch(ctx, in.journal, entry); err != nil {\n\t\treturn engineWiring{}, fmt.Errorf(\"engine: restoring the alert entry latch: %w\", err)\n\t}\n\n\tif err := bindOperatingModeProjection(ctx, in.journal, entry, in.accountRef, in.logger); err != nil {\n\t\treturn engineWiring{}, fmt.Errorf(\"engine: binding the operating-mode projection: %w\", err)\n\t}\n\tentry.SetAuthorityRefresh(func() error {\n\t\treturn tracker.Refresh(context.Background())\n\t})\n\n\tresolver := \u0026execgw.Resolver{\n\t\tJournal: in.journal,\n\t\tOrders:  orders,\n\t\tOrder:   orders,\n\t\tAccount: account,\n\t\tClock:   in.clock,\n\t\tGate:    entry,\n\t}\n\n\tbuildDigest, toolDigest := productionProtectionDigests()\n\tassemblies := productionProtectionAssemblies(buildDigest)\n\tprovider := protectionreadiness.NewProductionProvider(protectionreadiness.ProductionConfig{\n\t\tConfigDir: in.configDir, AccountID: in.accountRef, ProfileID: \"production\",\n\t\tBuildDigest: buildDigest, ToolDigest: toolDigest, ManifestDigest: in.manifestPin,\n\t\tNow: in.clock.Now, SupervisorAssemblies: assemblies,\n\t})\n\treadiness, err := protection.NewPairedReadinessAdapter(provider, in.accountRef, \"production\", provider.RuntimeContracts())\n\tif err != nil {\n\t\treturn engineWiring{}, fmt.Errorf(\"engine: constructing the paired read-only protection readiness adapter: %w\", err)\n\t}\n\treplay, err := newGatewayReplay(in.official, in.budget, func(err error) { fmt.Fprintln(redact.Writer(os.Stderr), err) })\n\tif err != nil {\n\t\treturn engineWiring{}, fmt.Errorf(\"engine: constructing replay transport: %w\", err)\n\t}\n\tgateway, err := execgw.New(execgw.Options{\n\t\tJournal:       in.journal,\n\t\tTrading:       in.trading,\n\t\tClock:         in.clock,\n\t\tAccountRef:    in.accountRef,\n\t\tSource:        engineSource,\n\t\tEntry:         entry,\n\t\tCancelRefusal: execgw.EngineCancelRefusal(),\n\n\t\tProtectionReadiness: readiness,\n\t\tPreflight:           \u0026execgw.Preflight{Account: account, Clock: in.clock},\n\t\tOrders:              orders,\n\t\tReplay:              replay,\n\n\t\tAttested: nil,\n\t})\n\tif err != nil {\n\t\treturn engineWiring{}, fmt.Errorf(\"engine: constructing the execution gateway: %w\", err)\n\t}\n\n\tnotifier := newNotifier(in.journal, entry, in.accountRef, in.logger, in.publisher, in.clock)\n\tretrier := newRetrier(in.journal, entry, in.accountRef, notifier, nil, in.clock)\n\tif in.budget != nil {\n\t\tseq, ok := in.official.SelectedAccountSeq()\n\t\tif !ok {\n\t\t\treturn engineWiring{}, accountbudget.ErrUnavailable\n\t\t}\n\t\tretrier, err = execgw.NewEnginePollRetrier(retrier, in.budget, in.official, in.accountRef, seq)\n\t\tif err != nil {\n\t\t\treturn engineWiring{}, err\n\t\t}\n\t}\n\n\tnames := \u0026InstrumentNames{}\n\talerter := notifierAlerter{notifier: notifier, names: names}\n\tingest := \u0026reconcile.Ingestor{\n\t\tJournal: in.journal, Alert: alerter, AccountRef: in.accountRef,\n\t}\n\tconverge := \u0026reconcile.Converger{\n\t\tJournal: in.journal, Credit: tracker, Alert: alerter, AccountRef: in.accountRef,\n\t}\n\n\treturn engineWiring{\n\t\tgateway:   gateway,\n\t\tentry:     entry,\n\t\tresolver:  resolver,\n\t\treconcile: tracker,\n\t\tretrier:   retrier,\n\t\tnotifier:  notifier,\n\t\tingest:    ingest,\n\t\tconverge:  converge,\n\t\tnames:     names,\n\t\tfloor: \u0026reconcileFloor{\n\t\t\tofficial: in.official, tracker: tracker, journal: in.journal,\n\t\t\tretrier: retrier, clk: in.clock, account: in.accountRef,\n\t\t},\n\t}, nil\n}",
   "internal/app/engine/gateway.go||newGatewayReplay": "func newGatewayReplay(client *official.Client, budget *accountbudget.Budget, cleanup func(error)) (execgw.ReplayTransport, error) {\n\tif budget == nil {\n\t\treturn execgw.HTTPReplay{BaseURL: client.BaseURL(), HTTP: \u0026http.Client{Timeout: replayTimeout}, Headers: client.AuthHeaders}, nil\n\t}\n\ttemplate := \u0026http.Transport{Proxy: http.ProxyFromEnvironment, DialContext: (\u0026net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second}).DialContext, MaxIdleConns: 100, IdleConnTimeout: 90 * time.Second, TLSHandshakeTimeout: 10 * time.Second, ExpectContinueTimeout: time.Second}\n\treturn execgw.NewBudgetedHTTPReplay(client.BaseURL(), \u0026http.Client{Transport: template, Timeout: replayTimeout}, client, budget, cleanup)\n}",
