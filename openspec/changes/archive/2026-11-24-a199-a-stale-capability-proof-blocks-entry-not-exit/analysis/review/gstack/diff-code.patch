+			if got := a199AuditCount(t, dir, audit.ActionGateAccepted) + a199AuditCount(t, dir, audit.ActionGateRefused); got != 0 {
+				t.Errorf("accepted+refused audit lines = %d, want 0 — exit-only is neither", got)
+			}
+		})
+	}
