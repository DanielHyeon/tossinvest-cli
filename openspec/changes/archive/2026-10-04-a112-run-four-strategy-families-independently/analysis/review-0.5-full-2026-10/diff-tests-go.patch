+func a112Calls(node ast.Node) []string {
+	var calls []string
+	ast.Inspect(node, func(child ast.Node) bool {
+		if call, ok := child.(*ast.CallExpr); ok {
+			calls = append(calls, calleeText(call.Fun))
+		}
+		return true
+	})
+	return calls
+}
