 {
  "id": "GO2-static-after-approval",
  "pkg": "v",
  "file": "internal/verifylive/reconcile.go",
  "why": "정적 거절(Q1·Q3)을 승인 뒤로(A-GREEN 리뷰어 변이 GO2)",
  "edits": [
   [
    "\t// 4. 정적 거절 — Q1·Q3 는 로컬 판정이라 사람 승인 **앞**에서 거절함(A-GREEN P2-a: y 를 누른 뒤에 측정 부재로\n\t// 거절당하는 모양 제거). 읽기 뒤의 재검(F7)은 그대로임.\n\tif err := checkReconcileRetention(target, now()); err != nil {\n\t\treturn ReconcileResult{}, err\n\t}\n\tif reconcileFreshnessBound <= 0 {\n\t\treturn ReconcileResult{}, refuse(RefuseFreshnessUnfixed, \"the Q3 freshness bound is not fixed\")\n\t}\n\n",
    ""
   ],
   [
    "\t// 6. 양성 대조 ①",
    "\tif err := checkReconcileRetention(target, now()); err != nil {\n\t\treturn ReconcileResult{}, err\n\t}\n\tif reconcileFreshnessBound <= 0 {\n\t\treturn ReconcileResult{}, refuse(RefuseFreshnessUnfixed, \"the Q3 freshness bound is not fixed\")\n\t}\n\n\t// 6. 양성 대조 ①"
   ]
  ]
 },
