+// PROBE: codex R1-1 의 순서 — 앞 크레딧 · QM 위에 사람 5 매도(스냅숏 15), 스냅숏 뒤 엔진 매도 5 가 창 안에 커밋(실제 10).
+func TestA201ProbeR11SnapshotOlderThanTheFill(t *testing.T) {
+	const symbol = "SYN201"
+	w := newA201World(t)
+	w.start(symbol) // 로컬 31 · 계좌 31, 엔진 매도 o-stop 열림
+	w.holds(symbol, "20", "100", 100)
+	w.stopOpenAtBroker(symbol, "31")
+	c := w.next()
+	w.logCycle("외부 매도 11(로컬 31 · 계좌 20) — 조정 · 크레딧 · QM", symbol, c)
+	// 사람이 5 더 매도 → 스냅숏 15. 엔진 매도(o-stop 의 부분 5)는 스냅숏 뒤 체결, 로컬 읽기 뒤 커밋.
+	w.holdings.items = nil
+	w.holds(symbol, "15", "100", 100)
+	w.stopOpenAtBroker(symbol, "31")
+	w.converge.at = a201BeforePositions
+	w.converge.fire = func() {
+		if _, err := w.journal.RecordFill(w.ctx, journal.FillObservation{
+			OrderID: "o-stop-" + symbol, Symbol: symbol, Market: "kr", TradingDay: a201Day, Side: "SELL",
+			AccountRef: reconcileAccount, State: "OPEN_PARTIALLY_FILLED", Terminal: false,
+			Quantity: "31", FilledQuantity: "5", AveragePrice: "100", ObservedAt: w.now(),
+		}); err != nil {
+			t.Fatalf("partial fill: %v", err)
+		}
+	}
+	c = w.next()
+	w.logCycle("R1-1 주기(스냅숏 15 · 로컬 읽기 20 · 체결 뒤 로컬 15)", symbol, c)
+	w.holdings.items = nil
+	w.holds(symbol, "10", "100", 100) // 실제 계좌 10
+	w.stopOpenAtBroker(symbol, "31")
+	c = w.next()
+	w.logCycle("다음 주기(계좌 10 · 로컬 15)", symbol, c)
+	c = w.next()
+	w.logCycle("그다음 주기", symbol, c)
+	w.assertStuck(symbol)
+}
+
+// PROBE: 연속 둘째 주기 — S1 의 W2 로 보류한 다음 주기에 S2 의 W2 가 오면 보류하지 않음.
+func TestA201ProbeSecondConsecutiveWindowIsJudged(t *testing.T) {
+	const s1, s2 = "SYN201A", "SYN201B"
+	w := newA201World(t)
+	w.hold(s1, "31")
+	w.hold(s2, "17")
+	w.holds(s1, "31", "100", 100)
+	w.holds(s2, "17", "100", 100)
+	w.stopOpenAtBroker(s1, "31")
+	w.stopOpenAtBroker(s2, "17")
+	if c := w.next(); c.Err != nil {
+		t.Fatalf("start cycle = %+v", c)
+	}
+	// 주기 1: 계좌가 S1 만 매도 반영, S1 체결은 창 안.
+	w.holdings.items = nil
+	w.orders.orders = nil
+	w.holds(s2, "17", "100", 100)
+	w.stopOpenAtBroker(s2, "17")
+	w.converge.at = a201BeforePositions
+	w.converge.fire = func() { w.stopFills(s1, "31") }
+	c := w.next()
+	w.logCycle("주기 1(S1 W2)", s1, c)
+	// 주기 2: 계좌가 S2 도 매도 반영, S2 체결은 창 안.
+	w.accountSold()
+	w.converge.fired = false
+	w.converge.fire = func() { w.stopFills(s2, "17") }
+	c = w.next()
+	w.logCycle("주기 2(S2 W2)", s2, c)
+	w.settleClean(s2, 3)
+	w.assertStuck(s1)
+	w.assertStuck(s2)
+}
