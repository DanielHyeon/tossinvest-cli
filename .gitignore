docs/superpowers/

# TossOS 포크 추가 규칙
# --------------------------------------------------------------------------
# 로컬 권한 그랜트(머신별) — 위 `/.claude/` 가 완화되어도 이 파일은 계속 제외한다.
.claude/settings.local.json

# 로컬 DB / 캐시 (세션·주문 이력 등이 담길 수 있음)
*.db
*.sqlite
*.sqlite3
# SQLite sidecar (WAL/SHM/journal) — ledger.db-wal, ledger.db-shm 등
*.db-*
*.sqlite-*

# 시크릿 — 위 `/.env`, `/.env.*` 는 루트만 덮으므로 하위 디렉터리까지 확장한다.
.env
.env.*

# TossOS: 루트 CLAUDE.md 는 개발 계약 포인터라 추적한다 (upstream 28행 무시 규칙 재정의)
!/CLAUDE.md

# Full SDD tracked agent configuration. settings.local.json remains machine-local.
!/.claude/
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.json
/.claude/settings.local.json

# Full SDD local indexes, event buffers, generated graph applications.
/.codegraph/
/.ai-context/
/.sdd/.venv/
/.sdd/gbrain-home/
/.sdd/index-state.json
/.sdd/history/checkpoints/
/.sdd/history/index-refresh.lock
/.sdd/history/refresh-queue/
/.sdd/history/events/*.jsonl
!/\.sdd/history/events/.gitkeep
/tmp/create-context-graph/
/docs/memory/index.jsonl
/docs/memory/index.db
/docs/memory/.ledger.lock
/docs/memory/.index-*
/docs/memory/.index.*.backup-*
