{
  "permissions": {
    "allow": [
      "Bash(openspec list *)",
      "Bash(openspec status *)",
      "Bash(openspec show *)",
      "Bash(openspec validate *)",
      "Bash(codegraph query *)",
      "Bash(codegraph context *)",
      "Bash(codegraph callers *)",
      "Bash(codegraph callees *)",
      "Bash(codegraph impact *)",
      "Bash(codegraph node *)",
      "Bash(codegraphcontext stats *)",
      "Bash(codegraphcontext report *)",
      "Bash(python3 tools/sdd/gbrain_project.py search *)",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/sdd-history/agent_save_hook.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/save-session.sh\" --hook > /dev/null 2>&1",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "codegraph sync 2>/dev/null || true",
            "async": true,
            "statusMessage": "Updating codegraph index..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/save-session.sh\" > /dev/null 2>&1",
            "async": true
          }
        ]
      }
    ]
  }
}
