{
  "permissions": {
    "allow": [
      "Bash(openspec list *)",
      "Bash(openspec status *)",
      "Bash(openspec show *)",
      "Bash(openspec validate *)",
      "Bash(codegraph query *)",
      "Bash(codegraph context *)",
      "Bash(codegraph callers *)",
      "Bash(codegraph callees *)",
      "Bash(codegraph impact *)",
      "Bash(codegraph node *)",
      "Bash(codegraphcontext stats *)",
      "Bash(codegraphcontext report *)",
      "Bash(python3 tools/sdd/gbrain_project.py search *)",
      "mcp__codegraph__codegraph_callers",
      "mcp__codegraph__codegraph_impact",
      "mcp__codegraph__codegraph_node"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/sdd-history/agent_save_hook.py"
          }
        ]
      }
    ]
  }
}
