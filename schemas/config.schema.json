{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JungHoonGhae/tossinvest-cli/main/schemas/config.schema.json",
  "title": "tossinvest-cli config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schema_version": {
      "type": "integer",
      "const": 5
    },
    "trading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place": {
          "type": "boolean",
          "default": false
        },
        "sell": {
          "type": "boolean",
          "default": false
        },
        "fractional": {
          "type": "boolean",
          "default": false
        },
        "cancel": {
          "type": "boolean",
          "default": false
        },
        "amend": {
          "type": "boolean",
          "default": false
        },
        "allow_live_order_actions": {
          "type": "boolean",
          "default": false
        },
        "dangerous_automation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accept_fx_consent": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "accept_fx_consent"
          ]
        }
      },
      "required": [
        "place",
        "cancel",
        "amend",
        "allow_live_order_actions",
        "dangerous_automation"
      ]
    },
    "update_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "openapi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "prefer": {
          "type": "string",
          "enum": ["auto", "wts", "official"],
          "default": "auto"
        },
        "fallback": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "engine": {
      "description": "Unattended trading engine settings. Ignored by tossctl itself.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automation_gate": {
          "description": "Master switch for unattended order placement. Turning it on is a human decision and is recorded in the audit log; the engine still refuses to start without a valid capability attestation and non-zero limits.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "attestation_file": {
              "type": "string"
            },
            "max_order_quantity": {
              "type": "number",
              "minimum": 0,
              "default": 0
            },
            "max_order_notional": {
              "type": "number",
              "minimum": 0,
              "default": 0
            },
            "limit_currency": {
              "type": "string",
              "enum": ["KRW", "USD"]
            }
          }
        },
        "adoption": {
          "description": "Whether externally acquired holdings are taken into the engine's exit management. Off by default; turning it on is a human decision recorded in the audit log. A default_stop_pct outside [0.02, 1) is refused and leaves adoption entirely off — below 0.02 the protective band is narrower than observation noise and the round-trip cost, which makes it a device that liquidates on the first tick.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "default_stop_pct": {
              "type": "number",
              "minimum": 0.02,
              "exclusiveMaximum": 1
            },
            "exclude_symbols": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "trading"
  ]
}
