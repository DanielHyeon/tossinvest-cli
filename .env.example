# Copy to .env and replace every value. Do not commit .env or these files.
# This must be the host's VPN interface address, never 0.0.0.0.
TOSSOS_VPN_BIND_IP=10.8.0.1
TOSSOS_VPN_CIDR=10.8.0.0/24
# Dedicated Compose bridge used only by this project. Keep it disjoint from the
# host/VPN/LAN routes; the console allows it so host-loopback requests still work.
TOSSOS_CONTAINER_CIDR=172.30.85.0/24
TOSSOS_CONSOLE_PORT=37085
TOSSOS_PUBLIC_URL=https://console.vpn.example:37085
# The API is a separate process and host port. Keep its DNS SAN and publish on
# the same VPN-only host address; never reuse a public/LAN interface.
TOSSOS_API_PORT=37086
TOSSOS_API_PUBLIC_URL=https://api.vpn.example:37086
# Explicit private container address; wildcard API binds are rejected.
TOSSOS_HTTPAPI_CONTAINER_IP=172.30.85.86

# Set these from `id -u` and `id -g`. Both must be non-zero. The image default is
# 10001:10001; Compose uses the host owner so 0600 secret bind mounts stay readable.
TOSSOS_UID=1000
TOSSOS_GID=1000

# Host directories. Create them first and grant the UID/GID above access.
TOSSOS_CONFIG_DIR=/srv/tossos/config
# Existing TossOS application data directory (contains journal.db/audit.log);
# Compose maps it directly and sets container TOSSOS_DATA_DIR to the mount root.
TOSSOS_DATA_DIR=/srv/tossos/data

# Host files, kept outside the repository. Use chmod 600 on all three.
TOSSOS_SESSION_FILE=/srv/tossos/secrets/session.json
TOSSOS_TLS_CERT_FILE=/srv/tossos/secrets/tls.crt
TOSSOS_TLS_KEY_FILE=/srv/tossos/secrets/tls.key
